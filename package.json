{
  "name": "@tacrine_f/oh-my-dsh-omo-fork-chs",
  "version": "0.1.0",
  "private": false,
  "description": "The unofficial Simplified Chinese fork of the tri-agent agent preset (Atlas orchestration plus Prometheus planning), packaged for DeepSeek Harness as a Cordis bundle; the vendored upstream content is licensed under SUL-1.0.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./persona": "./plan-aware-persona.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "plan-aware-persona.mjs",
    "index.js",
    "personas/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE-MIT.md",
    "LICENSE-SUL-1.0.md",
    "NOTICE.md",
    "tools/",
    "baseline/",
    "test/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent-instructions": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-agent-preset": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-command-compact": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-command-goal": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-plan-mode": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-skill-filesystem": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tool-ask-user": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tool-bash": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tool-fs": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tool-fs-search": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tool-goal": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tool-jobs": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tool-present": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tool-pwsh": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tool-ralph": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tool-skill": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tool-subagent": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tool-subagent-control": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tool-todo": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tool-web": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tool-workflow": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-workflow-ptc": ">=0.1.7-rc.2 <0.2.0"
  },
  "scripts": {
    "port": "node tools/port-patch.mjs",
    "baseline": "node tools/derive-baseline.mjs",
    "test": "node --test",
    "check": "node tools/check-package.mjs && node tools/verify-patch.mjs",
    "check:full": "node tools/verify-patch.mjs",
    "setup:verify": "npm install --prefix .dsh-verify --no-package-lock --legacy-peer-deps js-yaml@^4.1.0 @deepseek-ai/cordis-plugin-include@^1.0.9",
    "prepack": "node tools/check-package.mjs --quiet"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "SEE LICENSE IN NOTICE.md",
  "author": "Tacrine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tacrine/oh-my-dsh-omo-fork-chs.git"
  },
  "homepage": "https://github.com/Tacrine/oh-my-dsh-omo-fork-chs#readme",
  "bugs": {
    "url": "https://github.com/Tacrine/oh-my-dsh-omo-fork-chs/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "agent-preset",
    "tri-agent",
    "oh-my-dsh",
    "omo",
    "chinese",
    "zh-cn"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
